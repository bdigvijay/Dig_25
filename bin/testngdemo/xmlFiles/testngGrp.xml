<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="Suite">

  <test thread-count="5" name="Smoke Tests">
  	<groups>
  		<run>
  			<include name="Regression"></include>
  		</run>
  	</groups>
    <classes>
      <class name="testngdemo.TC3"/>
      <class name="testngdemo.TC1"/>
    </classes>
  </test> <!-- Test -->
  
  <test thread-count="5" name="Regression Tests">
  	  <groups>
  		<run>
  			<include name="Smoke"></include>
  			<exclude name="Redwire"></exclude>
  		</run>
  	</groups>
    <classes>
      <class name="testngdemo.TC2">
      <methods>
      		<include name="m1"></include>
      		<include name="m3"></include>
      		<include name="m5"></include>
      	</methods>
      </class>
    </classes>
  </test> <!-- Test -->
</suite> <!-- Suite -->
